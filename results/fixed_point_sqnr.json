  "method": {
    "range": "measured per value at every stage by the C++ frontend",
    "sqnr": "10*log10(rms^2 / (q^2/12)) with q = full_scale / 2^(bits-1)",
    "full_scale": "next power of two above the measured peak, or fixed for Q16.16",
    "per_frame": "the same formula applied to per-frame RMS quantiles from the measured log2 histogram, so quiet frames are not averaged away",
    "bin_resolution": "histogram quantiles return the lower edge of the octave bin, so every per-frame SQNR here is understated by 0 to 6 dB; the conclusion is conservative in the direction that matters",
    "bfp": "10*log10(12*2^(2*(b-1))) - crest, with crest measured per frame; a radix-2 exponent is charged the worst-case 6.02 dB placement",
    "sqnr_caveat": "textbook uniform-noise model; optimistic for the FFT stage where the error is not independent of the signal"
  },
